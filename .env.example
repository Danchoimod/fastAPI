PROJECT_NAME="Aura Notes API"
DEBUG=False
API_V1_STR="/api/v1"

# MongoDB Atlas URL
MONGODB_URL="mongodb+srv://username:password@cluster.mongodb.net/dbname?appName=Cluster0"
MONGODB_DB_NAME="fast_chat"

# JWT - thay thế bằng chuỗi bí mật mạnh trong production!
JWT_SECRET_KEY="your-super-secure-access-token-secret-key"
JWT_REFRESH_SECRET_KEY="your-super-secure-refresh-token-secret-key"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Gemini AI - lấy từ https://aistudio.google.com/
GEMINI_API_KEY="your-gemini-api-key"
GEMINI_MODEL="gemini-3.1-flash-lite-preview"

# SMTP (Gmail) - dùng App Password từ https://myaccount.google.com/apppasswords
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASSWORD="xxxx xxxx xxxx xxxx"

# Google Cloud Storage
# Khi chạy Docker, đường dẫn này sẽ tự động được set trong docker-compose.yml
# Khi chạy local thì dùng đường dẫn tuyệt đối đến file JSON credentials
GCS_CREDENTIALS_FILE="/app/credentials/gcs-key.json"
GCS_BUCKET_NAME="your-gcs-bucket-name"
